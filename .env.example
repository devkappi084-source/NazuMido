# Nazumido Server – Umgebungsvariablen
# Kopiere diese Datei zu ".env" und passe die Werte an.

# Port, auf dem der Express-Server lauscht
PORT=3000

# Pfad zur SQLite-Datenbankdatei (relativ zum Projektwurzelverzeichnis)
DB_PATH=./db/nazumido.sqlite

# Zielordner für hochgeladene Fotos
UPLOAD_DIR=./uploads

# Maximale Uploadgröße in Bytes (Standard: 5 MB)
MAX_UPLOAD_SIZE=5242880

# Erlaubte CORS-Ursprünge (kommagetrennt)
CORS_ORIGINS=http://localhost:3000,http://localhost:8787,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Authentifizierung (JWT)
# ---------------------------------------------------------------------------
# Geheimer Schlüssel zum Signieren der JWTs — in Produktion UNBEDINGT ändern
# (z. B. mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=bitte-hier-einen-langen-zufaelligen-wert-eintragen

# Gültigkeitsdauer der Tokens (z. B. 1h, 12h, 7d)
JWT_EXPIRES_IN=7d

# Standard-Admin, der beim ersten Start automatisch angelegt wird
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nazumido

# Node-Umgebung
NODE_ENV=development
