{
  "name": "nazumido",
  "version": "1.0.0",
  "private": true,
  "description": "Website des Faschingsvereins Nazumido — Cloudflare Pages + Pages Functions",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:local": "wrangler d1 execute nazumido-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute nazumido-db --remote --file=./schema.sql",
    "test": "wrangler pages functions build --outdir=./dist-worker && node test/worker.e2e.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "wrangler": "~4.120.1"
  }
}
